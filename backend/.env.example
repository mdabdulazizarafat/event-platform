# ==============================================================================
# RONG PLAN EVENT PLATFORM - PRODUCTION ENVIRONMENT VARIABLES (HOSTINGER VPS)
# ==============================================================================

# Server & Environment Configuration
NODE_ENV=production
PORT=3001
LOG_LEVEL=info

# CORS & Frontend URLs (Comma-separated list of allowed origins)
CORS_ORIGIN=https://rong-plan.com,https://www.rong-plan.com,http://localhost:5173
FRONTEND_URL=https://rong-plan.com

# PostgreSQL Database (Hostinger VPS Managed DB or Docker Postgres)
DATABASE_URL=postgresql://postgres:secure_password@localhost:5432/rong_plan?sslmode=disable
DB_POOL_MAX=25
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_SSL=false

# Stateless Asymmetric JWT Authentication (RS256)
# Generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
# Replace newlines with \n when storing as an inline env variable
JWT_PRIVATE_KEY=""
JWT_PUBLIC_KEY=""

# Redis Queue & High-Availability Config (BullMQ / Sidecar Workers)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
REDIS_SENTINEL_HOSTS=
REDIS_SENTINEL_MASTER_NAME=

# Cloudflare R2 Object Storage (CDN & Event Assets)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=rong-plan-assets
R2_PUBLIC_URL=https://assets.rong-plan.com

# Resend Transactional Mailer Credentials
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=tickets@rong-plan.com

# SSLCommerz Payment Gateway (Phase 2 - After Month 1 Free Registration Event)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_LIVE=false
SSLCOMMERZ_SUCCESS_URL=https://rong-plan.com/payment/success
SSLCOMMERZ_FAIL_URL=https://rong-plan.com/payment/fail
SSLCOMMERZ_CANCEL_URL=https://rong-plan.com/payment/cancel
SSLCOMMERZ_IPN_URL=https://api.rong-plan.com/api/v1/payments/ipn
